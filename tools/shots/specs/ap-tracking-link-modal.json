{
  "out": "images/affiliate-portal/tracking-link-modal.png",
  "alt": "The Copy tracking link modal on Enter URL, with a page URL entered and the final link for the brand that owns it",
  "capture": {
    "path": "/org/northwind-demo/affiliate-portal/affiliates/2",
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "waitFor": "text=Edit profile",
    "fixtures": [
      {
        "url": "/affiliate-portal/affiliates/\\d+/metrics",
        "file": "tools/shots/fixtures/affiliate-portal/affiliate-metrics.json"
      }
    ],
    "actions": [
      {
        "click": "[data-testid='org.affiliate-portal.affiliate.tracking-link']"
      },
      {
        "wait": 800
      },
      {
        "fill": "[data-testid='org.affiliate-portal.affiliate.tracking-link.base-url']",
        "value": "https://northwindsupplements.makeoffers.io/sleep-gummies"
      },
      {
        "wait": 1200
      }
    ],
    "hide": [
      "[data-testid='list.row']:has-text('onerror')",
      "[data-testid='list.row']:has-text('<b>')"
    ],
    "crop": ".ant-modal-content >> visible=true"
  },
  "annotations": [
    {
      "selector": "[data-testid='org.affiliate-portal.affiliate.tracking-link.mode-url']",
      "title": "Enter URL",
      "text": "Paste any page on a brand's domain",
      "side": "left"
    },
    {
      "selector": "[data-testid='org.affiliate-portal.affiliate.tracking-link.base-url']",
      "title": "Base URL",
      "text": "A page on the brand's domain",
      "side": "right"
    },
    {
      "selector": "[data-testid='org.affiliate-portal.affiliate.tracking-link.row'] >> nth=0",
      "title": "matched",
      "text": "The brand that owns the domain",
      "side": "left"
    },
    {
      "selector": "text=Copy link >> nth=0",
      "title": "Copy link",
      "text": "Link with their affid",
      "side": "right"
    }
  ],
  "maxWidth": 760,
  "calloutWidth": 230
}