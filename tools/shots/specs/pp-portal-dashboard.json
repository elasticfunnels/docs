{
  "out": "images/affiliate-portal/portal-dashboard.png",
  "alt": "The portal's Home page: commission, EPC, clicks and conversions for the last 30 days, the performance chart, clicks by brand and recent payouts",
  "capture": {
    "path": "/affiliates",
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "site": "portal",
    "login": "jordan.lee@example.com",
    "waitFor": "text=Performance over time",
    "fixtures": [
      {
        "url": "^/affiliates/api/dashboard",
        "file": "tools/shots/fixtures/affiliate-portal/dashboard.json"
      }
    ],
    "hide": [
      "[data-testid='list.row']:has-text('onerror')",
      "[data-testid='list.row']:has-text('<b>')"
    ],
    "crop": {
      "x": 0,
      "y": 0,
      "width": 1440,
      "height": 900
    }
  },
  "annotations": [
    {
      "selector": "text=Commission >> nth=0",
      "title": "Commission",
      "text": "Earned in the date range",
      "side": "right"
    },
    {
      "selector": "text=Current balance",
      "title": "Current balance",
      "text": "Earned, not paid yet",
      "side": "left"
    },
    {
      "selector": "text=Performance over time",
      "title": "Performance",
      "text": "The same numbers by day",
      "side": "right"
    }
  ],
  "maxWidth": 900,
  "calloutWidth": 230
}