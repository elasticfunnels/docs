{
  "out": "images/audiences/actions-list.png",
  "alt": "The When people enter or leave section of an audience: an email automation, an automation marked Automation off, a Klaviyo list sync and a webhook, each with its kind, its buttons and its counts",
  "capture": {
    "path": "/{brand}/analytics/segments/8",
    "viewport": {
      "width": 1440,
      "height": 2200
    },
    "waitFor": "[data-testid='segments.activations.row']",
    "fixtures": [
      {
        "url": "^/api/brands/{brand}/analytics/segments/8/activations/destinations$",
        "file": "tools/shots/fixtures/audiences/actions-destinations.json"
      },
      {
        "url": "^/api/brands/{brand}/analytics/segments/8/activations$",
        "file": "tools/shots/fixtures/audiences/actions.json"
      },
      {
        "url": "^/api/brands/{brand}/analytics/segments/8/export/columns",
        "file": "tools/shots/fixtures/audiences/export-columns.json"
      },
      {
        "url": "^/api/brands/{brand}/emails/all",
        "file": "tools/shots/fixtures/audiences/email-templates.json"
      }
    ],
    "actions": [
      {
        "scroll": "[data-testid='segments.activations.add']"
      }
    ],
    "crop": "section:has([data-testid='segments.activations.add'])",
    "cropPad": 12
  },
  "maxWidth": 900,
  "calloutWidth": 230,
  "annotations": [
    {
      "selector": "[data-testid='segments.activations.add']",
      "title": "Add",
      "text": "Opens the four choices",
      "side": "right"
    },
    {
      "selector": "[data-testid='segments.activations.row'] >> nth=0 >> [data-testid='segments.activations.row-kind']",
      "title": "Kind",
      "text": "Automation, Sync or Webhook",
      "side": "left"
    },
    {
      "selector": "[data-testid='segments.activations.row'] >> nth=0 >> div.flex-shrink-0",
      "title": "Open automation",
      "text": "Then Edit, Sync now, Pause",
      "side": "right"
    },
    {
      "selector": "[data-testid='segments.activations.row'] >> nth=1 >> div.flex-wrap.items-center",
      "title": "Automation off",
      "text": "Turn it on in the builder to send",
      "side": "left"
    },
    {
      "selector": "[data-testid='segments.activations.row'] >> nth=0 >> dl",
      "title": "Counts",
      "text": "Sent, held out, no consent, failed, pending",
      "side": "left"
    }
  ]
}
