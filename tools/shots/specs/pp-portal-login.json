{
  "out": "images/affiliate-portal/portal-login.png",
  "alt": "The portal's sign-in page with email, password and the Forgot password link",
  "capture": {
    "path": "/affiliates/login",
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "site": "portal",
    "waitFor": "#email",
    "hide": [
      "[data-testid='list.row']:has-text('onerror')",
      "[data-testid='list.row']:has-text('<b>')"
    ],
    "crop": {
      "x": 0,
      "y": 0,
      "width": 1440,
      "height": 900
    }
  },
  "annotations": [
    {
      "selector": "#email",
      "title": "Email",
      "text": "The address they signed up with",
      "side": "right"
    },
    {
      "selector": "text=Forgot password?",
      "title": "Forgot password?",
      "text": "Emails a reset link",
      "side": "right"
    }
  ],
  "maxWidth": 900,
  "calloutWidth": 230
}