{
  "out": "images/organization/billing-cards.png",
  "alt": "Organization Billing on the Payment Cards tab: the saved cards, the default card, and adding a card",
  "_source": "Local EF app (EF_APP=http://127.0.0.1:8010), demo organization 798. Billing data is fictional fixture JSON (fixtures/organization/billing-summary.json, payment-cards.json, invoices.json, billing-details.json): the local app has no Stripe customer and its usage summary needs ClickHouse. Re-shoot: EF_APP=<local app> node tools/shots/shoot.cjs organization-billing-cards",
  "capture": {
    "path": "/settings/organization/billing",
    "viewport": {
      "width": 1360,
      "height": 900
    },
    "fixtures": [
      {
        "url": "^/api/organizations/798/billing/summary$",
        "file": "tools/shots/fixtures/organization/billing-summary.json"
      },
      {
        "url": "^/api/organizations/798/payment-cards$",
        "file": "tools/shots/fixtures/organization/payment-cards.json"
      },
      {
        "url": "^/api/organizations/798/invoices$",
        "file": "tools/shots/fixtures/organization/invoices.json"
      },
      {
        "url": "^/api/organizations/798/billing-details$",
        "file": "tools/shots/fixtures/organization/billing-details.json"
      }
    ],
    "waitFor": "[data-testid='detail.tab.subscription']",
    "actions": [
      {
        "click": "[data-testid='detail.tab.payment_cards']"
      },
      {
        "wait": 1200
      }
    ],
    "hide": [
      ".toast",
      ".notifications",
      ".vue-notification-group"
    ],
    "crop": {
      "x": 265,
      "y": 270,
      "width": 725,
      "height": 222
    }
  },
  "maxWidth": 760,
  "calloutWidth": 210,
  "annotations": [
    {
      "selector": "main button:has-text('Add new card')",
      "title": "Add new card",
      "text": "Opens the secure card form"
    },
    {
      "selector": "main :text-is('Default') >> nth=-1",
      "title": "Default",
      "text": "The card each renewal charges"
    },
    {
      "title": "Set as default, Remove card",
      "text": "Switch the charged card, or delete one",
      "box": [
        452,
        176,
        245,
        30
      ]
    }
  ]
}