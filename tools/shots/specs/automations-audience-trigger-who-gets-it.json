{
  "out": "images/automations/audience-trigger-who-gets-it.png",
  "alt": "The On Entered Audience trigger: the audience, Who gets it set to Every time, at most once per N days with 14 days, Holdout 10% and the note that explains both choices",
  "capture": {
    "path": "/{brand}/automations/21/builder",
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "waitFor": "[data-testid='automations.builder.canvas-area']",
    "fixtures": [
      {
        "url": "^/api/brands/{brand}/automations/21(/builder)?(\\?|$)",
        "file": "tools/shots/fixtures/automation-audience-trigger/builder.json"
      },
      {
        "url": "^/api/brands/{brand}/analytics/audience-activations/audiences",
        "file": "tools/shots/fixtures/automation-audience-trigger/audiences.json"
      },
      {
        "url": "^/api/brands/{brand}/automations/sending-accounts",
        "file": "tools/shots/fixtures/automation-send-email/sending-accounts.json"
      },
      {
        "url": "^/api/brands/{brand}/emails/all",
        "file": "tools/shots/fixtures/automation-send-email/templates.json"
      }
    ],
    "actions": [
      {
        "click": ".vue-flow__node[data-id='trigger']",
        "wait": 1200
      },
      {
        "waitFor": "[data-testid='automations.field.reentry-help']"
      }
    ],
    "crop": {
      "x": 1032,
      "y": 125,
      "width": 398,
      "height": 460
    },
    "hide": [
      ".toast"
    ]
  },
  "maxWidth": 620,
  "calloutWidth": 210,
  "annotations": [
    {
      "selector": "[data-testid='automations.field.segment-id']",
      "title": "Audience",
      "text": "The audience it listens to",
      "side": "left"
    },
    {
      "selector": "[data-testid='automations.field.reentry']",
      "title": "Who gets it",
      "text": "First time only, or every time",
      "side": "left"
    },
    {
      "selector": "[data-testid='automations.field.cooldown-days']",
      "title": "N days",
      "text": "1 to 90, required for every time",
      "side": "left"
    },
    {
      "selector": "[data-testid='automations.field.holdout-percent']",
      "title": "Holdout",
      "text": "Never sent, counts as entered",
      "side": "left"
    },
    {
      "selector": "[data-testid='automations.field.reentry-help']",
      "title": "The rule",
      "text": "Explains both choices",
      "side": "left"
    }
  ]
}
