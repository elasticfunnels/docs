{
  "out": "images/campaigns/sms-message.png",
  "alt": "SMS campaign, Message step: text, character and part count, opt-out line, variants and phone preview",
  "_source": "demo brand 899 (Northwind Supplements), local app; fictional campaign data in fixtures/campaigns",
  "capture": {
    "path": "/{brand}/campaigns/sms/2/edit",
    "viewport": {
      "width": 1440,
      "height": 1300
    },
    "waitFor": "[data-testid=\"campaigns.sms.composer\"]",
    "crop": {
      "x": 248,
      "y": 61,
      "width": 1192,
      "height": 900
    },
    "actions": [
      {
        "click": "[data-testid=\"campaigns.sms.composer.step.message\"]"
      },
      {
        "wait": 1500
      }
    ],
    "fixtures": [
      {
        "url": "^/api/brands/{brand}/sms/campaigns/options",
        "file": "tools/shots/fixtures/campaigns/sms-options.json"
      },
      {
        "url": "^/api/brands/{brand}/sms/campaigns/preview-audience",
        "file": "tools/shots/fixtures/campaigns/sms-preview-audience.json",
        "method": "POST"
      },
      {
        "url": "^/api/brands/{brand}/sms/campaigns/2/preview",
        "file": "tools/shots/fixtures/campaigns/sms-preview.json",
        "method": "POST"
      },
      {
        "url": "^/api/brands/{brand}/sms/campaigns/2(\\?|$)",
        "file": "tools/shots/fixtures/campaigns/sms-campaign-2.json"
      }
    ]
  },
  "maxWidth": 760,
  "calloutWidth": 220,
  "annotations": [
    {
      "selector": "text=1 part",
      "title": "Length",
      "text": "Characters and parts, GSM or Unicode",
      "side": "left"
    },
    {
      "selector": "text=Add opt-out line",
      "title": "Opt-out line",
      "text": "Added after every text",
      "side": "left"
    },
    {
      "selector": "text=Add a variant",
      "title": "Variants",
      "text": "Up to 4 extra versions to test",
      "side": "left"
    },
    {
      "selector": "text=Send test",
      "title": "Test",
      "text": "Send it to your own phone"
    }
  ]
}