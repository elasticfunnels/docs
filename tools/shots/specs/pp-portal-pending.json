{
  "out": "images/affiliate-portal/portal-pending.png",
  "alt": "The portal dashboard of an affiliate still waiting for approval, with the notice at the top",
  "capture": {
    "path": "/affiliates",
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "site": "portal",
    "login": "marco.reyes@example.com",
    "passwordEnv": "EF_PORTAL_PASSWORD_PENDING",
    "waitFor": "[data-testid='affiliates.dashboard.pending-notice']",
    "fixtures": [
      {
        "url": "^/affiliates/api/dashboard",
        "file": "tools/shots/fixtures/affiliate-portal/dashboard.json"
      }
    ],
    "hide": [
      "[data-testid='list.row']:has-text('onerror')",
      "[data-testid='list.row']:has-text('<b>')"
    ],
    "crop": {
      "x": 0,
      "y": 0,
      "width": 1440,
      "height": 900
    }
  },
  "annotations": [
    {
      "selector": "[data-testid='affiliates.dashboard.pending-notice']",
      "title": "Waiting for approval",
      "text": "Links appear once approved",
      "side": "right"
    }
  ],
  "maxWidth": 900,
  "calloutWidth": 230
}