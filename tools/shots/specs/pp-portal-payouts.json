      "y": 0,
      "width": 1440,
      "height": 900
    }
  },
  "annotations": [
    {
      "selector": ".ant-table-wrapper",
      "title": "Payouts",
      "text": "Status, invoice and paid date",
      "side": "right"
    }
  ],
  "maxWidth": 900,
  "calloutWidth": 230
}