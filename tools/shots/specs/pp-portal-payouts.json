{
  "out": "images/affiliate-portal/portal-payouts.png",
  "alt": "The Payouts page on the portal listing paid and pending payouts with amount, method, status and paid date",
  "capture": {
    "path": "/affiliates/payouts",
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "site": "portal",
    "login": "jordan.lee@example.com",
