  "maxWidth": 760,
  "calloutWidth": 220,
  "annotations": [
    { "selector": "text=Auth ID >> visible=true >> nth=0", "title": "Auth ID", "text": "20 characters, from the console overview" },
    { "selector": "text=Auth Token >> visible=true >> nth=0", "title": "Auth Token", "text": "Also checks Plivo's signed callbacks" },
    { "selector": "text=Where to find these", "title": "Where to find these", "text": "Links to the Plivo console" }
  ]
