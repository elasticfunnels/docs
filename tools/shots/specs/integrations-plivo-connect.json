{
  "out": "images/integrations/plivo-connect.png",
  "alt": "The Plivo connection form: Name, Auth ID and Auth Token, with where to find them in the Plivo console",
  "_source": "demo brand 899 (Northwind Supplements), local app at elasticfunnels origin/main 29b3afb27",
  "capture": {
