{
  "out": "images/affiliate-portal/portal-register.png",
  "alt": "The portal's sign-up form with full name, email, optional phone and password, in the portal's branding",
  "capture": {
    "path": "/affiliates/register",
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "site": "portal",
    "waitFor": "input[placeholder='Jane Doe']",
    "hide": [
      "[data-testid='list.row']:has-text('onerror')",
      "[data-testid='list.row']:has-text('<b>')"
    ],
    "crop": {
      "x": 0,
      "y": 0,
      "width": 1440,
      "height": 900
    }
  },
  "annotations": [
    {
      "selector": "input[placeholder='Jane Doe']",
      "title": "Full name",
      "text": "Shown to you in the app",
      "side": "right"
    },
    {
      "selector": "input[type=tel]",
      "title": "Phone",
      "text": "Optional",
      "side": "right"
    },
    {
      "selector": "button[type=submit]",
      "title": "Create account",
      "text": "Sends a 6-digit code",
      "side": "right"
    }
  ],
  "maxWidth": 900,
  "calloutWidth": 230
}