{
  "out": "images/quizzes/design-typography.png",
  "alt": "Quiz builder Design tab: font family, heading weight, corner radius, question text size, weight and alignment, subtitle style, and Custom CSS",
  "capture": {
    "path": "/{brand}/quizzes/40/builder",
    "viewport": {
      "width": 1440,
      "height": 1000
    },
    "waitFor": "[data-testid='quizzes.builder.mode.design']",
    "actions": [
      {
        "wait": 2500
      },
      {
        "click": "[data-testid='quizzes.builder.mode.design']"
      },
      {
        "wait": 1500
      },
      {
        "click": "[data-testid='quizzes.builder.dock.close']"
      },
      {
        "wait": 800
      },
      {
        "fill": "[data-testid='quizzes.builder.design.custom-css']",
        "value": ".promo-note { font-size: 14px; color: #475569; }"
      },
      {
        "wait": 400
      },
      {
        "scroll": "[data-testid='quizzes.builder.design.heading-weight']"
      },
      {
        "wait": 1000
      }
    ],
    "crop": {
      "x": 1056,
      "y": 225,
      "width": 384,
      "height": 775
    },
    "cropPad": 0
  },
  "maxWidth": 420,
  "annotations": [
    {
      "box": [
        17,
        51,
        351,
        51
      ],
      "title": "Font family",
      "text": "Applied to the live quiz",
      "side": "left"
    },
    {
      "box": [
        17,
        121,
        351,
        55
      ],
      "title": "Weight and radius",
      "text": "Headings and corners, quiz-wide",
      "side": "right"
    },
    {
      "box": [
        17,
        193,
        351,
        294
      ],
      "title": "Question text",
      "text": "Size, weight, alignment, subtitles",
      "side": "left"
    },
    {
      "box": [
        17,
        593,
        351,
        160
      ],
      "title": "Custom CSS",
      "text": "Scoped to this quiz, checked on save",
      "side": "right"
    }
  ],
  "calloutWidth": 200
}