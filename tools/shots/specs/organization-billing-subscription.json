{
  "out": "images/organization/billing-subscription.png",
  "alt": "Organization Billing on the Subscription tab: the Pro plan with its price and renewal date, Change plan, Cancel subscription and this period's usage",
  "_source": "Local EF app (EF_APP=http://127.0.0.1:8010), demo organization 798. Billing data is fictional fixture JSON (fixtures/organization/billing-summary.json, payment-cards.json, invoices.json, billing-details.json): the local app has no Stripe customer and its usage summary needs ClickHouse. Re-shoot: EF_APP=<local app> node tools/shots/shoot.cjs organization-billing-subscription",
  "capture": {
    "path": "/settings/organization/billing",
    "viewport": {
      "width": 1360,
      "height": 900
    },
    "fixtures": [
      {
        "url": "^/api/organizations/798/billing/summary$",
        "file": "tools/shots/fixtures/organization/billing-summary.json"
      },
      {
        "url": "^/api/organizations/798/payment-cards$",
        "file": "tools/shots/fixtures/organization/payment-cards.json"
      },
      {
        "url": "^/api/organizations/798/invoices$",
        "file": "tools/shots/fixtures/organization/invoices.json"
      },
      {
        "url": "^/api/organizations/798/billing-details$",
        "file": "tools/shots/fixtures/organization/billing-details.json"
      }
    ],
    "waitFor": "[data-testid='detail.tab.subscription']",
    "actions": [
      {
        "wait": 800
      }
    ],
    "hide": [
      ".toast",
      ".notifications",
      ".vue-notification-group"
    ],
    "crop": {
      "x": 265,
      "y": 75,
      "width": 1080,
      "height": 650
    }
  },
  "maxWidth": 760,
  "calloutWidth": 210,
  "annotations": [
    {
      "selector": "[data-testid='detail.tabs']",
      "title": "Billing tabs",
      "text": "Plan, credits, details, cards, invoices",
      "side": "left",
      "pad": 2
    },
    {
      "selector": "text=Change plan",
      "title": "Change plan",
      "text": "Upgrade or downgrade the organization",
      "side": "left"
    },
    {
      "selector": "main button:has-text('Cancel subscription')",
      "title": "Cancel subscription",
      "text": "Stops renewal at the period end",
      "side": "left"
    },
    {
      "selector": "text=Usage this period",
      "title": "Usage this period",
      "text": "What the plan has used so far",
      "side": "left"
    }
  ]
}